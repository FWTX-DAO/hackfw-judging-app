# ─── Required in production ────────────────────────────────────────────
# At least 32 characters; use a random string — signs judge/admin session tokens. Rotating it
# invalidates every existing session. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Admin console PIN. Generate 8 random digits (keep any leading zeros):
# bun -e 'console.log(require("node:crypto").randomInt(100_000_000).toString().padStart(8, "0"))'
# Existing random passwords of at least 12 characters are also supported.
ADMIN_PIN=

# ─── Common ────────────────────────────────────────────────────────────
# HTTP listen port (default 3000)
PORT=3000

# Where SQLite + WAL files live. In Docker / Fly, point this at your
# mounted volume (e.g. /data/hackathon.db). Production requires an absolute path.
DB_FILE=data/hackathon.db

# Set to "production" to enable strict mode: refuse to boot without
# strong SESSION_SECRET + ADMIN_PIN, an absolute DB_FILE, and built frontend.
NODE_ENV=development

# ─── Optional: Turso embedded-replica sync ─────────────────────────────
# Leave unset for local-only operation. With these set, the local DB
# becomes a libSQL embedded replica that syncs with a remote Turso DB.
# TURSO_SYNC_URL=
# TURSO_AUTH_TOKEN=
# TURSO_SYNC_INTERVAL=60       # seconds — libSQL pull cadence
# TURSO_SYNC_TICK_MS=30000     # ms — server-side sync tick

# Set only behind Fly Proxy; otherwise leave unset and use the socket IP.
# TRUST_PROXY=fly
